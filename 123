<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Монитор статусов Pro</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');
 
        * { margin: 0; padding: 0; box-sizing: border-box; }
 
        body {
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            background: #f4f6fa;
            color: #0f172a;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
 
        /* ===== АСИММЕТРИЧНЫЙ ЭКРАН ВХОДА ===== */
        #loginScreen {
            display: flex;
            width: 100vw;
            height: 100vh;
            background: #ffffff;
        }
 
        .login-side-decor {
            flex: 1;
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 60px;
            color: #ffffff;
        }

        @media (max-width: 768px) { .login-side-decor { display: none; } }

        .login-side-decor h2 { font-size: 42px; font-weight: 700; margin-bottom: 16px; letter-spacing: -0.03em; }
        .login-side-decor p { font-size: 18px; opacity: 0.85; line-height: 1.6; }

        .login-side-form {
            width: 100%;
            max-width: 480px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 60px 40px;
        }
 
        .login-title {
            font-size: 28px;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 8px;
            letter-spacing: -0.02em;
        }
 
        .login-sub {
            font-size: 15px;
            color: #64748b;
            margin-bottom: 40px;
            line-height: 1.5;
        }
 
        .btn-google {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            width: 100%;
            padding: 16px;
            background: #ffffff;
            color: #1e293b;
            border: 2px solid #e2e8f0;
            border-radius: 16px;
            font-family: inherit;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }
 
        .btn-google:hover { background: #f8fafc; border-color: #cbd5e1; transform: translateY(-1px); }
        .btn-google:active { transform: translateY(1px); }
        .btn-google:disabled { opacity: 0.5; cursor: not-allowed; }
        .btn-google svg { width: 22px; height: 22px; }
 
        /* ===== ДАШБОРД С ИЗМЕНЕННОЙ КОМПОНОВКОЙ ===== */
        #appScreen {
            display: none;
            width: 100%;
            max-width: 1200px;
            padding: 32px 24px;
        }
 
        /* Новая модульная сетка: Участники слева (занимают больше места) */
        .main-layout {
            display: grid;
            grid-template-columns: 1.8fr 1fr;
            gap: 32px;
        }
 
        @media (max-width: 850px) { .main-layout { grid-template-columns: 1fr; } }
 
        /* Левая колонка: Профиль + Участники */
        .left-column {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .dashboard-header {
            background: #ffffff;
            border-radius: 24px;
            padding: 24px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.02);
            display: flex;
            align-items: center;
            justify-content: space-between;
            border: 1px solid #e9edf5;
        }

        .profile-section {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .avatar {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            font-weight: 700;
            color: white;
            overflow: hidden;
            box-shadow: 0 8px 16px rgba(79, 70, 229, 0.2);
        }
        .avatar img { width: 100%; height: 100%; object-fit: cover; }

        .profile-info h3 { font-size: 16px; font-weight: 700; color: #0f172a; }
        .profile-info p { font-size: 13px; color: #64748b; margin-top: 2px; }

        .btn-logout {
            background: #fff3f3;
            border: none;
            color: #ef4444;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            padding: 10px 18px;
            border-radius: 12px;
            transition: all 0.2s;
        }
        .btn-logout:hover { background: #fee2e2; }

        .panel {
            background: #ffffff;
            border-radius: 28px;
            padding: 32px;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.03);
            border: 1px solid #e9edf5;
        }
 
        .panel-title {
            font-size: 18px;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            letter-spacing: -0.01em;
        }
 
        /* Измененная форма кнопок статуса: теперь это вертикальный список-карточки */
        .status-vertical-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 24px;
        }
 
        .status-opt {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 20px;
            border-radius: 18px;
            border: 2px solid #f1f5f9;
            cursor: pointer;
            background: #f8fafc;
            transition: all 0.2s ease;
            font-size: 15px;
            font-weight: 600;
            color: #334155;
        }
 
        .status-opt:hover { border-color: #cbd5e1; background: #f1f5f9; }
 
        .status-opt.selected {
            border-color: #4f46e5;
            background: #ffffff;
            color: #4f46e5;
            box-shadow: 0 10px 20px rgba(79, 70, 229, 0.08);
        }

        .status-opt-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }
 
        .dot {
            width: 12px;
            height: 12px;
            border-radius: 6px;
            flex-shrink: 0;
        }
 
        .dot-online  { background: #10b981; }
        .dot-away    { background: #f59e0b; }
        .dot-busy    { background: #ef4444; }
        .dot-offline { background: #94a3b8; }

        /* Кастомный чекбокс-круг справа внутри опции выбора */
        .radio-mark {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            border: 2px solid #cbd5e1;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }
        .status-opt.selected .radio-mark {
            border-color: #4f46e5;
            background: #4f46e5;
        }
        .status-opt.selected .radio-mark::after {
            content: '';
            width: 8px;
            height: 8px;
            background: #ffffff;
            border-radius: 50%;
        }
 
        .btn-update {
            width: 100%;
            padding: 16px;
            background: #4f46e5;
            color: white;
            border: none;
            border-radius: 18px;
            font-family: inherit;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 6px 20px rgba(79, 70, 229, 0.25);
        }
 
        .btn-update:hover { background: #4338ca; transform: translateY(-1px); }
        .btn-update:active { transform: translateY(1px); }
        .btn-update:disabled { background: #cbd5e1; color: #94a3b8; cursor: not-allowed; box-shadow: none; }
 
        /* Измененный список участников: более просторный, карточный */
        .user-list {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            max-height: 520px;
            overflow-y: auto;
            padding-right: 6px;
        }
 
        @media (max-width: 580px) { .user-list { grid-template-columns: 1fr; } }
 
        .user-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 16px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            transition: all 0.2s ease;
        }
 
        .user-item.me {
            border-color: #c7d2fe;
            background: linear-gradient(135deg, #f5f7ff 0%, #eef2ff 100%);
        }
 
        .user-av {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            font-weight: 700;
            color: #475569;
            flex-shrink: 0;
            overflow: hidden;
        }
        .user-av img { width: 100%; height: 100%; object-fit: cover; }
 
        .user-info { flex: 1; min-width: 0; }
        .user-name { font-size: 15px; font-weight: 700; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .user-name-me { color: #4f46e5; }
 
        .status-label {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            font-weight: 600;
            color: #64748b;
            margin-top: 4px;
            background: #ffffff;
            padding: 4px 10px;
            border-radius: 10px;
            border: 1px solid #e2e8f0;
        }
 
        .live-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            font-weight: 700;
            color: #10b981;
            background: #e6fcf5;
            padding: 6px 12px;
            border-radius: 12px;
        }
 
        .live-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #10b981;
            animation: pulse 2s infinite;
        }
 
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }
 
        .empty-state { grid-column: 1 / -1; padding: 40px; text-align: center; color: #94a3b8; font-size: 14px; }
 
        /* Скроллбар */
        .user-list::-webkit-scrollbar { width: 6px; }
        .user-list::-webkit-scrollbar-track { background: transparent; }
        .user-list::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
    </style>
</head>
<body>
 
<div id="loginScreen">
    <div class="login-side-decor">
        <h2>Монитор статусов</h2>
        <p>Следите за доступностью команды в реальном времени на едином интерактивном дашборде.</p>
    </div>
    <div class="login-side-form">
        <div class="login-title">Добро пожаловать</div>
        <div class="login-sub">Авторизуйтесь, чтобы войти в рабочее пространство</div>
 
        <button class="btn-google" id="loginBtn">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Войти через Google
        </button>
    </div>
</div>
 
<div id="appScreen">
    <div class="main-layout">
         
        <div class="left-column">
            <div class="dashboard-header">
                <div class="profile-section">
                    <div class="avatar" id="myAvatar">?</div>
                    <div class="profile-info">
                        <h3 id="myName">Загрузка…</h3>
                        <p>Supabase Realtime Sync</p>
                    </div>
                </div>
                <button class="btn-logout" id="logoutBtn">Выйти</button>
            </div>

            <div class="panel">
                <div class="panel-title">
                    Команда
                    <span class="live-badge"><span class="live-dot"></span>живой поток</span>
                </div>
                <div class="user-list" id="userList">
                    <div class="empty-state">Синхронизация участников…</div>
                </div>
            </div>
        </div>

        <div class="panel" style="height: max-content;">
            <div class="panel-title">Мой статус</div>
 
            <div class="status-vertical-list">
                <div class="status-opt selected" data-status="online">
                    <div class="status-opt-left">
                        <span class="dot dot-online"></span> Онлайн
                    </div>
                    <div class="radio-mark"></div>
                </div>
                <div class="status-opt" data-status="away">
                    <div class="status-opt-left">
                        <span class="dot dot-away"></span> Отошёл
                    </div>
                    <div class="radio-mark"></div>
                </div>
                <div class="status-opt" data-status="busy">
                    <div class="status-opt-left">
                        <span class="dot dot-busy"></span> Занят
                    </div>
                    <div class="radio-mark"></div>
                </div>
                <div class="status-opt" data-status="offline">
                    <div class="status-opt-left">
                        <span class="dot dot-offline"></span> Офлайн
                    </div>
                    <div class="radio-mark"></div>
                </div>
            </div>
 
            <button class="btn-update" id="updateBtn">Обновить присутствие</button>
        </div>

    </div>
</div>
 
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const SUPABASE_URL = "https://zkgaabzztwrzktxezcoa.supabase.co";
        const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InprZ2FhYnp6dHdyemt0eGV6Y29hIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzcyNzYzNzAsImV4cCI6MjA5Mjg1MjM3MH0.Yy8wA9X-M-fyff92Jlam-NJFFypHZtKrC0mYDNwqGKs";
 
        const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
 
        let currentUser = null;
        let selectedStatus = "online";
        let realtimeChannel = null;
        let usersState = []; 
 
        const loginScreen = document.getElementById("loginScreen");
        const appScreen   = document.getElementById("appScreen");
        const loginBtn    = document.getElementById("loginBtn");
        const logoutBtn   = document.getElementById("logoutBtn");
        const updateBtn   = document.getElementById("updateBtn");
        const userList    = document.getElementById("userList");
        const myAvatar    = document.getElementById("myAvatar");
        const myName      = document.getElementById("myName");
 
        const STATUS_META = {
            online:  { label: "Онлайн",  cls: "dot-online"  },
            away:    { label: "Отошёл",  cls: "dot-away"    },
            busy:    { label: "Занят",   cls: "dot-busy"    },
            offline: { label: "Офлайн",  cls: "dot-offline" },
        };
 
        function initials(name) {
            if (!name) return "?";
            return name.split(" ").map(w => w[0]).join("").slice(0,2).toUpperCase();
        }
 
        function escapeHtml(s) {
            return (s || "").replace(/[&<>]/g, m => ({"&":"&amp;","<":"&lt;",">":"&gt;"}[m]));
        }
 
        function showLogin() {
            loginScreen.style.display = "flex";
            appScreen.style.display = "none";
            loginBtn.textContent = "Войти через Google";
            loginBtn.disabled = false;
            currentUser = null;
            if (realtimeChannel) {
                realtimeChannel.unsubscribe();
                realtimeChannel = null;
            }
        }
 
        loginBtn.addEventListener("click", async () => {
            loginBtn.textContent = "Перенаправление…";
            loginBtn.disabled = true;
            await supabase.auth.signInWithOAuth({
                provider: "google",
                options: { redirectTo: window.location.origin + window.location.pathname }
            });
        });
 
        logoutBtn.addEventListener("click", async () => {
            if (currentUser) {
                await supabase.from("profiles").update({ status: "offline" }).eq("id", currentUser.id);
            }
            await supabase.auth.signOut();
            showLogin();
        });
 
        document.querySelectorAll(".status-opt").forEach(el => {
            el.addEventListener("click", () => {
                document.querySelectorAll(".status-opt").forEach(e => e.classList.remove("selected"));
                el.classList.add("selected");
                selectedStatus = el.dataset.status;
            });
        });
 
        updateBtn.addEventListener("click", async () => {
            if (!currentUser) return;
            updateBtn.disabled = true;
            updateBtn.textContent = "Сохранение…";
 
            const { error } = await supabase
                .from("profiles")
                .update({ status: selectedStatus })
                .eq("id", currentUser.id);
 
            if (error) alert("Ошибка: " + error.message);
 
            updateBtn.disabled = false;
            updateBtn.textContent = "Обновить присутствие";
        });
 
        function renderUsers() {
            if (usersState.length === 0) {
                userList.innerHTML = '<div class="empty-state">Нет участников.</div>';
                return;
            }
 
            userList.innerHTML = usersState.map(u => {
                const isMe = currentUser && u.id === currentUser.id;
                const st = STATUS_META[u.status] || STATUS_META["offline"];
                const name = escapeHtml(u.username || u.email || "Без имени");
                const av = u.avatar_url
                    ? `<img src="${escapeHtml(u.avatar_url)}" referrerpolicy="no-referrer" alt="">`
                    : initials(u.username || u.email);
 
                return `
                    <div class="user-item${isMe ? " me" : ""}">
                        <div class="user-av">${av}</div>
                        <div class="user-info">
                            <div class="user-name${isMe ? " user-name-me" : ""}">${name}</div>
                            <div class="status-label">
                                <span class="dot ${st.cls}"></span> ${st.label}
                            </div>
                        </div>
                    </div>
                `;
            }).join("");
        }
 
        async function fetchInitialUsers() {
            const { data, error } = await supabase
                .from("profiles")
                .select("id, username, email, status, avatar_url")
                .order("username", { ascending: true });
 
            if (error) return;
            usersState = data || [];
            renderUsers();
 
            if (currentUser) {
                const me = usersState.find(u => u.id === currentUser.id);
                if (me && me.status) {
                    document.querySelectorAll(".status-opt").forEach(el => {
                        el.classList.toggle("selected", el.dataset.status === me.status);
                    });
                    selectedStatus = me.status;
                }
            }
        }
 
        function setupRealtime() {
            if (realtimeChannel) realtimeChannel.unsubscribe();
            realtimeChannel = supabase
                .channel("profiles-changes")
                .on("postgres_changes", { event: "*", schema: "public", table: "profiles" }, (payload) => {
                    const { eventType, new: newRow, old: oldRow } = payload;
                    if (eventType === "INSERT") {
                        if (!usersState.some(u => u.id === newRow.id)) usersState.push(newRow);
                    } else if (eventType === "UPDATE") {
                        usersState = usersState.map(u => u.id === newRow.id ? { ...u, ...newRow } : u);
                    } else if (eventType === "DELETE") {
                        usersState = usersState.filter(u => u.id !== oldRow.id);
                    }
                    usersState.sort((a, b) => (a.username || "").localeCompare(b.username || ""));
                    renderUsers();
                })
                .subscribe();
        }
 
        async function showApp(user) {
            currentUser = user;
            loginScreen.style.display = "none";
            appScreen.style.display = "block";
 
            const meta = user.user_metadata || {};
            const name = meta.full_name || meta.name || user.email || "Пользователь";
            myName.textContent = name;
 
            if (meta.avatar_url || meta.picture) {
                myAvatar.innerHTML = `<img src="${meta.avatar_url || meta.picture}" referrerpolicy="no-referrer" alt="">`;
            } else {
                myAvatar.textContent = initials(name);
            }
 
            const { data: profile } = await supabase
                .from("profiles")
                .select("status")
                .eq("id", user.id)
                .maybeSingle(); // Предотвращает критические падения, если профиля еще нет
 
            if (!profile) {
                await supabase.from("profiles").insert({
                    id: user.id,
                    username: name,
                    email: user.email,
                    avatar_url: meta.avatar_url || meta.picture || null,
                    status: "online"
                });
            } else if (profile.status === "offline") {
                await supabase.from("profiles").update({ status: "online" }).eq("id", user.id);
            }
 
            await fetchInitialUsers();
            setupRealtime();
        }
 
        // Исправленная и безопасная обработка изменения авторизации
        supabase.auth.onAuthStateChange(async (event, session) => {
            console.log("Supabase Auth Event:", event);
            
            if (session?.user) {
                // Очищаем хэш токены из адресной строки, чтобы страница выглядела красиво
                if (window.location.hash) {
                    window.history.replaceState(null, null, window.location.pathname);
                }
                await showApp(session.user);
            } else {
                // Показываем форму логина только если страница не находится в процессе чтения токенов OAuth
                if (event !== 'INITIAL_SESSION' || !window.location.hash) {
                    showLogin();
                }
            }
        });
    });
</script>
</body>
</html>
